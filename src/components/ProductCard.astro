---
import Shoe from './Shoe.astro';
import L from './L.astro';
import { stockLabels, stockLabelsEn, type Product } from '../data/site';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
---

<li data-gender={p.gender} data-category={p.category} data-color={p.color} data-name={p.name.toLowerCase()} data-slug={p.slug}>
  <a class="card" href={`/catalog/${p.slug}/`}>
    <span class="badge"><L en={stockLabelsEn[p.stock]} ro={stockLabels[p.stock]} /></span>
    <Shoe hex={p.hex} label={p.name} />
    <h3>{p.name}</h3>
    <span class="price">{p.price} lei</span>
  </a>
  <button type="button" class="fav" data-fav={p.slug} aria-pressed="false" aria-label={`Favorite: ${p.name}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.600-7 10-7 10Z"></path></svg>
  </button>
</li>
