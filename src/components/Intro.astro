---
import { BRAND, TAGLINE } from '../data/site';
---

<section class="landing" id="landing" aria-label="Introducere">
  <div class="landing-fallback" aria-hidden="true"></div>
  <canvas id="landing-canvas" aria-hidden="true"></canvas>
  <div class="landing-content">
    <h1 class="landing-logo">{BRAND}</h1>
    <p class="landing-sub">{TAGLINE}</p>
    <button type="button" id="enter" class="enter">ENTER THE EXPERIENCE</button>
  </div>
  <div class="scroll-cue" aria-hidden="true"><span></span></div>
</section>

<style is:global>
  html:has(#landing) { scroll-snap-type: y proximity; }
  #landing, #store { scroll-snap-align: start; }
</style>

<style>
  .landing { position: relative; height: 100vh; height: 100svh; min-height: 480px; overflow: hidden; background: #0b0b0b; --p: 0; }
  .landing-fallback { position: absolute; inset: 0; background:
    radial-gradient(120% 40% at 20% 78%, #2a2a2c 0%, transparent 60%),
    radial-gradient(110% 35% at 85% 92%, #333 0%, transparent 60%),
    radial-gradient(90% 30% at 60% 60%, #1b1b1d 0%, transparent 70%),
    linear-gradient(#0d0d0e, #161617 70%, #0b0b0b);
    background-size: 160% 100%, 180% 100%, 150% 100%, 100% 100%; animation: drift 18s ease-in-out infinite alternate; }
  .landing-fallback::after { content: ''; position: absolute; inset: 0; opacity: .5; background-image:
    radial-gradient(circle, #d4af37 0 1px, transparent 1.5px), radial-gradient(circle, #f0deaa 0 1px, transparent 1.5px);
    background-size: 90px 70px, 140px 110px; background-position: 0 0, 40px 30px; animation: sparkle 9s linear infinite; }
  @keyframes drift { to { background-position: 40% 0, -30% 0, 25% 0, 0 0; } }
  @keyframes sparkle { to { background-position: 90px 70px, 180px 140px; } }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .8s; }
  canvas.on { opacity: 1; }
  .landing-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 1.25rem;
    transform: translateY(calc(var(--p) * -60px)); opacity: calc(1 - var(--p) * 1.5); pointer-events: none; text-shadow: 0 2px 24px #000; }
  .landing-logo { margin: 0; font-weight: 200; letter-spacing: .45em; padding-left: .45em; font-size: clamp(2.6rem, 14vw, 6rem); line-height: 1.2; }
  .landing-sub { margin: 1rem 0 2.5rem; color: #cbbd9a; letter-spacing: .22em; font-size: clamp(.62rem, 2.6vw, .85rem); }
  .enter { pointer-events: auto; min-height: 56px; padding: 0 2rem; font: inherit; font-size: .85rem; letter-spacing: .2em; color: #0b0b0b; cursor: pointer;
    background: linear-gradient(135deg, #f0deaa, #d4af37 55%, #b8902a); border: 0; border-radius: 999px; box-shadow: 0 0 40px #d4af3755; text-shadow: none; touch-action: manipulation; }
  .enter:disabled { opacity: .7; cursor: default; }
  .enter:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .scroll-cue { position: absolute; left: 50%; bottom: max(1.25rem, env(safe-area-inset-bottom)); width: 22px; height: 38px; margin-left: -11px; border: 1px solid #ffffff66; border-radius: 12px; opacity: calc(1 - var(--p) * 3); }
  .scroll-cue span { position: absolute; left: 50%; top: 7px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: #d4af37; animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 0; } 30% { opacity: 1; } 80% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .landing-fallback, .landing-fallback::after, .scroll-cue span { animation: none; } }
</style>

<script>
  // Dune landscape: a one-off "bake" pass renders a tileable heightmap into a texture; the per-frame shader only
  // maps a perspective ground plane onto it, lights it, and adds wind-blown sand. Touch writes into a tiny
  // low-resolution displacement texture on the CPU that decays back to flat sand.
  const PRE = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
`;
  const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';

  const BAKE = PRE + `
float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
float pnoise(vec2 p,float per){ vec2 i=floor(p),f=fract(p); f=f*f*(3.-2.*f); vec2 a=mod(i,per),b=mod(i+1.,per);
  return mix(mix(hash(a),hash(vec2(b.x,a.y)),f.x),mix(hash(vec2(a.x,b.y)),hash(b),f.x),f.y); }
float pfbm(vec2 p,float per){ float v=0.,a=.5; for(int i=0;i<4;i++){ v+=a*pnoise(p,per); p*=2.; per*=2.; a*=.5; } return v; }
float prof(float s){ return smoothstep(0.,.8,s)*(1.-smoothstep(.8,1.,s)); }
void main(){
  vec2 uv=gl_FragCoord.xy/512.;
  float ph=uv.y*4.+pfbm(uv*3.,3.)*1.3;
  float amp=.6+.4*pnoise(uv*2.,2.);
  float h1=prof(fract(ph))*amp;
  float ph2=uv.y*9.+pfbm(uv*7.+3.,7.)*1.6;
  float h2=prof(fract(ph2))*(.5+.5*pnoise(uv*4.+5.,4.));
  float macro=(h1+h2*.2)/1.25;
  float rip=sin(uv.y*220.+pfbm(uv*16.,16.)*7.)*.5+.5;
  float streak=pfbm(uv*32.,32.);
  gl_FragColor=vec4(macro,rip,streak,1.);
}`;

  const FRAG = PRE + `
uniform sampler2D uTex; uniform sampler2D uDisp;
uniform vec2 uRes; uniform vec2 uTexel;
uniform float uTime; uniform float uProg; uniform float uBurst; uniform float uCam;
float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
void main(){
  vec2 suv=gl_FragCoord.xy/uRes; float asp=uRes.x/uRes.y;
  float dy=.72-suv.y;
  float dyc=max(dy,.0008);
  float z=.3/(dyc+.012);
  float near=exp(-z*.3);
  vec2 w=vec2((suv.x-.5)*asp*z*1.25, z+uCam+uTime*.01);
  vec2 tc=w*.5;
  float e=.004;
  vec3 t0=texture2D(uTex,tc).rgb;
  float h=t0.r;
  float hx=texture2D(uTex,tc+vec2(e,0.)).r;
  float hz=texture2D(uTex,tc+vec2(0.,e)).r;
  float d0=(texture2D(uDisp,suv).r-.5)*2.;
  float dxp=texture2D(uDisp,suv+vec2(uTexel.x,0.)).r-texture2D(uDisp,suv-vec2(uTexel.x,0.)).r;
  float dyp=texture2D(uDisp,suv+vec2(0.,uTexel.y)).r-texture2D(uDisp,suv-vec2(0.,uTexel.y)).r;
  float dn=.35+.65*near;
  vec3 n=normalize(vec3(-((hx-h)/e*.5+dxp*12.*dn),1.,-((hz-h)/e*.5+dyp*12.*dn)));
  float rip=texture2D(uTex,tc*7.).g;
  n.xz+=vec2(.05,.4)*(rip-.5)*(.2+.8*near);
  n=normalize(n);
  vec3 L=normalize(vec3(-.75,.3,.55));
  float diff=max(dot(n,L),0.)*(1.+(rip-.5)*.7*(.3+.7*near));
  float hs=max(texture2D(uTex,tc+L.xz*.02).r,texture2D(uTex,tc+L.xz*.05).r*.9);
  float occ=clamp((hs-h-d0*.05)*9.-.04,0.,1.);
  float lit=diff*(1.-.75*occ);
  vec3 sun=vec3(1.,.9,.76);
  vec3 col=vec3(.14,.13,.12)*(sun*lit*2.3+vec3(.11,.115,.13))*(1.-clamp(-d0*.7,0.,.6));

  // Wind: fine sand streaming off the crests (left to right) plus a faint low layer drifting over the surface.
  float crest=smoothstep(.4,.85,h)*(1.-occ);
  float s1=texture2D(uTex,vec2(tc.x*.1-uTime*.045,tc.y*1.1)).b;
  float s2=texture2D(uTex,vec2(tc.x*.2-uTime*.09+.37,tc.y*2.3+.2)).b;
  float stream=smoothstep(.52,.8,s1)*crest*.9+smoothstep(.55,.85,s2)*.28*(.4+.6*lit);
  col+=sun*vec3(.3,.26,.2)*stream*(.35+.65*lit)*(.5+.5*near);

  // Very sparse, subtle glints (the only gold).
  vec2 cell=floor(w*vec2(600.,600.));
  float r=hash(cell);
  float tw=.5+.5*sin(uTime*2.+r*60.);
  float glint=step(.9972,r)*tw*smoothstep(.1,.6,lit)*near*(1.+abs(d0)*5.);
  col+=vec3(1.,.82,.52)*glint*.38;

  float fog=1.-exp(-z*.09);
  vec3 hzc=vec3(.075,.064,.052);
  col=mix(col,hzc,fog*.85);
  vec3 sky=mix(vec3(.016,.016,.018),hzc*1.05,exp(dy*10.)*.85);
  col=mix(sky,col,smoothstep(-.004,.004,dy));
  col=mix(col,vec3(.043),clamp(uProg*.92+smoothstep(.55,1.,uBurst),0.,1.));
  vec2 vv=suv-.5; col*=1.-.4*dot(vv,vv);
  gl_FragColor=vec4(col,1.);
}`;

  const landing = document.getElementById('landing');
  const canvas = document.getElementById('landing-canvas') as HTMLCanvasElement | null;
  const enterBtn = document.getElementById('enter') as HTMLButtonElement | null;
  if (landing && canvas && enterBtn) init(landing, canvas, enterBtn);

  function compile(gl: WebGLRenderingContext, type: number, src: string): WebGLShader | null {
    const s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { gl.deleteShader(s); return null; }
    return s;
  }
  function program(gl: WebGLRenderingContext, frag: string): WebGLProgram | null {
    const vs = compile(gl, gl.VERTEX_SHADER, VERT), fs = compile(gl, gl.FRAGMENT_SHADER, frag), pr = gl.createProgram();
    if (!vs || !fs || !pr) return null;
    gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.bindAttribLocation(pr, 0, 'p'); gl.linkProgram(pr);
    return gl.getProgramParameter(pr, gl.LINK_STATUS) ? pr : null;
  }

  function init(landing: HTMLElement, canvas: HTMLCanvasElement, enterBtn: HTMLButtonElement) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches || innerWidth < 700;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const budget = coarse ? 380000 : 550000; // render pixels, upscaled by CSS
    let quality = 1;

    const store = document.getElementById('store');
    let entering = false;
    let burstStart = -1;
    let rafScroll = 0;
    const t0 = performance.now();
    const clock = () => ((performance.now() - t0) / 1000) * (reduced ? 0.35 : 1);

    // ---- touch displacement field (CPU, low resolution, decays) ----
    let gw = 1, gh = 1;
    let field = new Float32Array(1);
    let out = new Uint8Array(1);
    const ripples: { x: number; y: number; t: number }[] = [];
    let lastInput = -1e9;
    let cssW = 1, cssH = 1;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, depth: false, stencil: false, powerPreference: 'low-power' });

    const toGrid = (cx: number, cy: number) => {
      const r = landing.getBoundingClientRect();
      return { x: ((cx - r.left) / cssW) * gw, y: (1 - (cy - r.top) / cssH) * gh };
    };
    function trail(cx: number, cy: number) {
      const g = toGrid(cx, cy);
      const rad = 2.4;
      for (let j = Math.max(0, Math.floor(g.y - 4)); j <= Math.min(gh - 1, Math.ceil(g.y + 4)); j++) {
        for (let i = Math.max(0, Math.floor(g.x - 4)); i <= Math.min(gw - 1, Math.ceil(g.x + 4)); i++) {
          const d2 = (i - g.x) ** 2 + (j - g.y) ** 2;
          const k = j * gw + i;
          field[k] = Math.max(-1, field[k]! - 0.8 * Math.exp(-d2 / (rad * rad)));
        }
      }
      lastInput = performance.now();
    }
    function ripple(cx: number, cy: number) {
      const g = toGrid(cx, cy);
      ripples.push({ x: g.x, y: g.y, t: performance.now() });
      if (ripples.length > 4) ripples.shift();
      lastInput = performance.now();
    }

    const last = new Map<number, { x: number; y: number; sx: number; sy: number; st: number }>();
    const onTouch = (e: TouchEvent, phase: 'start' | 'move' | 'end') => {
      const list = phase === 'end' ? e.changedTouches : e.touches;
      for (let k = 0; k < list.length && k < 3; k++) {
        const t = list[k]!;
        const s = last.get(t.identifier);
        if (phase === 'start') {
          last.set(t.identifier, { x: t.clientX, y: t.clientY, sx: t.clientX, sy: t.clientY, st: performance.now() });
          trail(t.clientX, t.clientY);
        } else if (phase === 'move' && s) {
          if (Math.hypot(t.clientX - s.x, t.clientY - s.y) > 10) { trail(t.clientX, t.clientY); s.x = t.clientX; s.y = t.clientY; }
        } else if (phase === 'end' && s) {
          const tap = Math.hypot(t.clientX - s.sx, t.clientY - s.sy) < 12 && performance.now() - s.st < 350;
          if (tap && !(e.target as Element).closest('button')) ripple(t.clientX, t.clientY);
          last.delete(t.identifier);
        }
      }
    };
    landing.addEventListener('touchstart', (e) => onTouch(e, 'start'), { passive: true });
    landing.addEventListener('touchmove', (e) => onTouch(e, 'move'), { passive: true });
    landing.addEventListener('touchend', (e) => onTouch(e, 'end'), { passive: true });
    landing.addEventListener('touchcancel', (e) => onTouch(e, 'end'), { passive: true });
    let lm = 0;
    landing.addEventListener('mousemove', (e) => { const n = performance.now(); if (n - lm > 30) { lm = n; trail(e.clientX, e.clientY); } });
    landing.addEventListener('click', (e) => { if (e.detail > 0 && !(e.target as Element).closest('button')) ripple(e.clientX, e.clientY); });

    // ---- entering the store: button or first desktop wheel gesture; touch users scroll natively (CSS snap helps) ----
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const finish = () => { cancelAnimationFrame(rafScroll); entering = false; burstStart = -1; enterBtn.disabled = false; enterBtn.removeAttribute('aria-busy'); };
    const enter = () => {
      if (entering || !store) return;
      const target = store.getBoundingClientRect().top + scrollY;
      if (reduced) { scrollTo(0, target); return; }
      entering = true; enterBtn.disabled = true; enterBtn.setAttribute('aria-busy', 'true');
      burstStart = performance.now();
      const from = scrollY, dur = 1300, html = document.documentElement;
      html.style.scrollSnapType = 'none';
      const step = (now: number) => {
        const k = Math.min(1, (now - burstStart) / dur);
        scrollTo(0, from + (target - from) * ease(k));
        if (k < 1) rafScroll = requestAnimationFrame(step); else { html.style.scrollSnapType = ''; finish(); }
      };
      rafScroll = requestAnimationFrame(step);
    };
    enterBtn.addEventListener('click', enter);
    addEventListener('wheel', (e) => {
      if (entering) { e.preventDefault(); return; }
      if (e.deltaY > 8 && scrollY < 4) { e.preventDefault(); enter(); }
    }, { passive: false });
    const abort = () => { if (entering) { document.documentElement.style.scrollSnapType = ''; finish(); } };
    addEventListener('touchstart', abort, { passive: true });
    addEventListener('keydown', abort);

    let progress = 0;
    const readProgress = () => {
      progress = Math.min(1, Math.max(0, scrollY / (landing.offsetHeight * 0.9)));
      landing.style.setProperty('--p', progress.toFixed(3));
    };
    addEventListener('scroll', readProgress, { passive: true });
    readProgress();

    if (!gl) return;
    const bake = program(gl, BAKE), main = program(gl, FRAG);
    if (!bake || !main) return;

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    // One-off bake of the tileable dune heightmap (R: dunes, G: wind ripples, B: streak noise).
    const SIZE = 512;
    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, SIZE, SIZE, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    const fbo = gl.createFramebuffer();
    gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
    gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
    if (gl.checkFramebufferStatus(gl.FRAMEBUFFER) !== gl.FRAMEBUFFER_COMPLETE) return;
    gl.viewport(0, 0, SIZE, SIZE);
    gl.useProgram(bake);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
    gl.bindFramebuffer(gl.FRAMEBUFFER, null);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.generateMipmap(gl.TEXTURE_2D);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);

    const dispTex = gl.createTexture();
    gl.activeTexture(gl.TEXTURE1);
    gl.bindTexture(gl.TEXTURE_2D, dispTex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);

    gl.useProgram(main);
    const U = (n: string) => gl.getUniformLocation(main, n);
    const uRes = U('uRes'), uTexel = U('uTexel'), uTime = U('uTime'), uProg = U('uProg'), uBurst = U('uBurst'), uCam = U('uCam');
    gl.uniform1i(U('uTex'), 0);
    gl.uniform1i(U('uDisp'), 1);

    const resize = () => {
      cssW = Math.max(1, landing.clientWidth); cssH = Math.max(1, landing.clientHeight);
      const s = Math.min(1, Math.sqrt((budget * quality) / (cssW * cssH * dpr * dpr)));
      canvas.width = Math.max(1, Math.round(cssW * dpr * s));
      canvas.height = Math.max(1, Math.round(cssH * dpr * s));
      gw = Math.min(128, Math.ceil(cssW / 14)); gh = Math.min(192, Math.ceil(cssH / 14));
      field = new Float32Array(gw * gh);
      out = new Uint8Array(gw * gh).fill(128);
      gl.activeTexture(gl.TEXTURE1);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.LUMINANCE, gw, gh, 0, gl.LUMINANCE, gl.UNSIGNED_BYTE, out);
      gl.uniform2f(uTexel, 1 / gw, 1 / gh);
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    resize();
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(resize, 120); });
    canvas.classList.add('on');

    let visible = true, running = true, frames = 0, acc = 0, prev = 0, lastDraw = 0, lastFrame = 0, dirty = false;
    new IntersectionObserver(([en]) => { visible = !!en?.isIntersecting; }).observe(landing);
    canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); running = false; canvas.classList.remove('on'); });

    function updateField(now: number, dt: number) {
      const active = ripples.length > 0 || now - lastInput < 4000;
      if (!active && !dirty) return;
      const decay = Math.exp(-dt * 0.7);
      for (let k = 0; k < field.length; k++) field[k] = field[k]! * decay;
      for (let k = ripples.length - 1; k >= 0; k--) if (now - ripples[k]!.t > 3000) ripples.splice(k, 1);
      for (let j = 0; j < gh; j++) {
        for (let i = 0; i < gw; i++) {
          const k = j * gw + i;
          let v = field[k]!;
          for (const r of ripples) {
            const age = (now - r.t) / 1000;
            const x = (Math.hypot(i - r.x, j - r.y) - age * 9) / 1.7;
            v += 0.5 * Math.exp(-age * 1.3) * Math.exp(-x * x) * Math.cos(x * 2);
          }
          out[k] = Math.max(0, Math.min(255, Math.round(128 + 127 * v)));
        }
      }
      gl!.activeTexture(gl!.TEXTURE1);
      gl!.texSubImage2D(gl!.TEXTURE_2D, 0, 0, 0, gw, gh, gl!.LUMINANCE, gl!.UNSIGNED_BYTE, out);
      dirty = ripples.length > 0 || field.some((f) => Math.abs(f) > 0.004);
    }

    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!running || !visible || document.hidden) { prev = 0; return; }
      const busy = now - lastInput < 1500 || burstStart >= 0 || ripples.length > 0 || (progress > 0 && progress < 1);
      if (now - lastDraw < (busy ? 15 : 32)) return;
      const dt = Math.min(0.1, (now - (lastFrame || now)) / 1000);
      lastFrame = now;
      if (prev) {
        acc += now - prev; frames++;
        if (frames === 40) {
          const avg = acc / frames;
          const target = busy ? 18 : 36;
          if (avg > target * 1.35 && quality > 0.3) { quality *= 0.75; resize(); }
          frames = 0; acc = 0;
        }
      }
      prev = now; lastDraw = now;
      updateField(now, dt);
      const burst = burstStart < 0 ? 0 : ease(Math.min(1, (now - burstStart) / 1300));
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, clock());
      gl.uniform1f(uProg, progress);
      gl.uniform1f(uBurst, burst);
      gl.uniform1f(uCam, progress * 1.2 + burst * 4);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => { prev = 0; lastFrame = 0; });
  }
</script>
