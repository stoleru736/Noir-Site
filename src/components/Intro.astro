<section class="intro" id="intro" aria-label="Introducere animată" hidden>
  <canvas id="intro-canvas" aria-hidden="true"></canvas>
  <div class="intro-text">
    <p class="intro-logo">NOIR</p>
    <button type="button" id="intro-skip" class="intro-skip">Derulează pentru a intra ↓</button>
  </div>
</section>

<style>
  .intro{position:relative;width:100vw;margin-left:calc(50% - 50vw);height:calc(100svh - 64px);min-height:420px;background:#0b0b0b;overflow:hidden}
  .intro[hidden]{display:none}
  canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  .intro-text{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;pointer-events:none}
  .intro-logo{margin:0;font-weight:200;letter-spacing:.6em;font-size:clamp(2rem,9vw,5rem);padding-left:.6em;mix-blend-mode:difference}
  .intro-skip{pointer-events:auto;background:none;border:0;color:var(--mut);font:inherit;font-size:.8rem;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;position:absolute;bottom:1.5rem}
  .intro-skip:hover,.intro-skip:focus-visible{color:var(--fg)}
</style>

<script>
  const intro = document.getElementById('intro') as HTMLElement;
  const canvas = document.getElementById('intro-canvas') as HTMLCanvasElement;
  const skip = document.getElementById('intro-skip') as HTMLButtonElement;
  const KEY = 'noir-intro-seen';

  let seen = false;
  try { seen = sessionStorage.getItem(KEY) === '1'; } catch { /* storage blocked */ }
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ctx = canvas.getContext('2d');

  if (!seen && !reduced && ctx) {
    intro.hidden = false;
    try { sessionStorage.setItem(KEY, '1'); } catch { /* ignore */ }
    run(ctx);
  }

  function run(c: CanvasRenderingContext2D) {
    const mobile = innerWidth < 700;
    const count = mobile ? 800 : 2000;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    let w = 0, h = 0;
    const resize = () => {
      w = intro.clientWidth; h = intro.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      c.setTransform(dpr, 0, 0, dpr, 0, 0);
      c.fillStyle = '#0b0b0b'; c.fillRect(0, 0, w, h);
    };
    resize();
    addEventListener('resize', resize);

    const px = new Float32Array(count), py = new Float32Array(count), sz = new Float32Array(count), al = new Float32Array(count);
    for (let i = 0; i < count; i++) {
      px[i] = Math.random() * innerWidth; py[i] = Math.random() * innerHeight;
      sz[i] = 0.5 + Math.random() * 1.4; al[i] = 0.25 + Math.random() * 0.6;
    }

    let t = 0, raf = 0, visible = true, last = 0;
    const field = (x: number, y: number) =>
      Math.sin(x * 0.004 + t) * 1.6 + Math.cos(y * 0.006 - t * 0.7) * 1.6 + Math.sin((x + y) * 0.002 + t * 0.4) * 2;

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || now - last < 16) return;
      last = now; t += 0.004;
      c.fillStyle = 'rgba(11,11,11,0.07)';
      c.fillRect(0, 0, w, h);
      for (let i = 0; i < count; i++) {
        const a = field(px[i]!, py[i]!);
        px[i]! += Math.cos(a) * 1.4 + 0.6;
        py[i]! += Math.sin(a) * 1.4;
        if (px[i]! > w) px[i]! = 0; else if (px[i]! < 0) px[i]! = w;
        if (py[i]! > h) py[i]! = 0; else if (py[i]! < 0) py[i]! = h;
        c.fillStyle = `rgba(214,204,186,${al[i]})`;
        c.fillRect(px[i]!, py[i]!, sz[i]!, sz[i]!);
      }
    };

    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; }).observe(intro);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); } else { raf = requestAnimationFrame(frame); } });
    raf = requestAnimationFrame(frame);
  }

  skip.addEventListener('click', () => {
    document.getElementById('main-content')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
