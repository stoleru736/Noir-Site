---
// Placeholder sneaker (no photos yet): a <use> of the shared sprite, tinted per product.
interface Props {
  hex: string;
  view?: number;
  label: string;
}
const { hex, view = 0, label } = Astro.props;
const bgs = ['#141821', '#1a1f2a', '#10141c'];
const bg = bgs[view % bgs.length];
const transform = view === 1 ? 'translate(400 0) scale(-1 1)' : view === 2 ? 'translate(0 36) scale(1 .86)' : undefined;
---

<svg viewBox="0 0 400 400" width="400" height="400" role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} style={`--c:${hex};--bg:${bg}`}>
  <use href="#shoe" width="400" height="400" transform={transform}></use>
</svg>
