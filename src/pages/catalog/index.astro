---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import L from '../../components/L.astro';
import { BRAND, catalog, genderLabels, genderLabelsEn, colorEn } from '../../data/site';

const unique = (key: 'category' | 'color') => [...new Set(catalog.map((p) => p[key]))];
const colors = [...new Map(catalog.map((p) => [p.color, p])).entries()];
---

<Base title={`Catalog — ${BRAND}`} description={`The ${BRAND} catalog: filter by gender, category and colour.`}>
  <h1>Catalog</h1>
  <form class="filters" id="filters">
    <label><L en="Gender" ro="Gen" />
      <select name="gender">
        <option value="" data-t-en="All" data-t-ro="Toate">All</option>
        {Object.entries(genderLabels).map(([v, l]) => <option value={v} data-t-en={genderLabelsEn[v as keyof typeof genderLabelsEn]} data-t-ro={l}>{genderLabelsEn[v as keyof typeof genderLabelsEn]}</option>)}
      </select>
    </label>
    <label><L en="Category" ro="Categorie" />
      <select name="category">
        <option value="" data-t-en="All" data-t-ro="Toate">All</option>
        {unique('category').map((v) => <option value={v}>{v.charAt(0).toUpperCase() + v.slice(1)}</option>)}
      </select>
    </label>
    <label><L en="Colour" ro="Culoare" />
      <select name="color">
        <option value="" data-t-en="All" data-t-ro="Toate">All</option>
        {colors.map(([v, p]) => <option value={v} data-t-en={colorEn(p)} data-t-ro={p.colorLabel}>{colorEn(p)}</option>)}
      </select>
    </label>
  </form>
  <ul class="grid" id="grid">
    {catalog.map((p) => <ProductCard product={p} />)}
  </ul>
  <p class="empty" id="empty" hidden><L en="No model matches the chosen filters." ro="Niciun model pentru filtrele alese." /></p>
  <script>
    const form = document.getElementById('filters') as HTMLFormElement;
    const items = document.querySelectorAll<HTMLElement>('#grid > li');
    const empty = document.getElementById('empty') as HTMLElement;
    const keys = ['gender', 'category', 'color'] as const;
    const q = (new URLSearchParams(location.search).get('q') ?? '').trim().toLowerCase();
    const apply = () => {
      const data = new FormData(form);
      let shown = 0;
      items.forEach((li) => {
        const ok = keys.every((k) => {
          const v = data.get(k);
          return !v || li.dataset[k] === v;
        });
        const match = ok && (!q || (li.dataset['name'] ?? '').includes(q));
        li.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
    };
    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
  </script>
</Base>
