---
import Base from '../../layouts/Base.astro';
import Shoe from '../../components/Shoe.astro';
import L from '../../components/L.astro';
import { BRAND, catalog, genderLabels, genderLabelsEn, stockLabels, stockLabelsEn, colorEn, descriptionEn, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return catalog.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product: p } = Astro.props;
const views = [0, 1, 2];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: descriptionEn(p),
  color: colorEn(p),
  brand: { '@type': 'Brand', name: BRAND },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'RON',
    price: p.price,
    availability: p.stock === 'stock' ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
  },
};
const orderBase = `Salut! Vreau să comand ${p.name} (${p.colorLabel}), mărimea `;
---

<Base title={`${p.name} — ${BRAND}`} description={descriptionEn(p)} jsonLd={jsonLd}>
  <article class="product">
    <div class="gallery">
      {views.map((v) => (
        <div data-view={v} hidden={v !== 0}><Shoe hex={p.hex} view={v} label={`${p.name}, view ${v + 1}`} /></div>
      ))}
      <div class="thumbs">
        {views.map((v) => (
          <button type="button" data-thumb={v} aria-label={`View ${v + 1}`} data-a="aria-label" data-a-en={`View ${v + 1}`} data-a-ro={`Vedere ${v + 1}`} aria-current={v === 0}>
            <Shoe hex={p.hex} view={v} label="" />
          </button>
        ))}
      </div>
    </div>
    <div>
      <p class="note"><L en={`${genderLabelsEn[p.gender]} · ${p.category.charAt(0).toUpperCase() + p.category.slice(1)} · ${colorEn(p)}`} ro={`${genderLabels[p.gender]} · ${p.category.charAt(0).toUpperCase() + p.category.slice(1)} · ${p.colorLabel}`} /></p>
      <h1>{p.name}</h1>
      <p>{p.price} lei · <strong><L en={stockLabelsEn[p.stock]} ro={stockLabels[p.stock]} /></strong></p>
      <p><L en={descriptionEn(p)} ro={p.description} /></p>
      <fieldset class="sizes" style="border:0;padding:0">
        <legend><L en="Size" ro="Mărime" /></legend>
        {p.sizes.map((s, i) => (
          <label><input type="radio" name="size" value={s} checked={i === 0} />{s}</label>
        ))}
      </fieldset>
      <div class="buybar">
        <strong class="bigprice">{p.price} lei</strong>
        <button type="button" class="btn solid" id="add-bag"><span class="t"><L en="Add to bag" ro="Adaugă în coș" /></span><span class="ok"><L en="Added ✓" ro="Adăugat ✓" /></span></button>
      </div>
      <a class="btn" id="order" href={whatsappLink(orderBase + p.sizes[0])} data-base={orderBase} data-phone="40750437127"><L en="Order directly on WhatsApp" ro="Comandă direct pe WhatsApp" /></a>
      <p class="note"><L
        en={p.stock === 'stock' ? 'Delivery 1–2 days, pay on delivery.' : 'Pre-order: delivery 9–21 days, 10% advance.'}
        ro={p.stock === 'stock' ? 'Livrare 1–2 zile, plată ramburs.' : 'Pre-order: livrare 9–21 zile, avans 10%.'} /> <a href="/garantie/"><L en="Warranty details" ro="Detalii garanție" /></a></p>
    </div>
  </article>
  <script>
    import { addItem } from '../../scripts/cart';
    const views = document.querySelectorAll<HTMLElement>('[data-view]');
    const thumbs = document.querySelectorAll<HTMLElement>('[data-thumb]');
    thumbs.forEach((t) =>
      t.addEventListener('click', () => {
        views.forEach((v) => (v.hidden = v.dataset.view !== t.dataset.thumb));
        thumbs.forEach((o) => o.setAttribute('aria-current', String(o === t)));
      }),
    );
    const slug = location.pathname.split('/').filter(Boolean).pop() ?? '';
    const addBtn = document.getElementById('add-bag') as HTMLButtonElement;
    addBtn.addEventListener('click', () => {
      const sel = document.querySelector<HTMLInputElement>('input[name=size]:checked');
      if (!sel) return;
      addItem(slug, Number(sel.value));
      addBtn.dataset['done'] = '';
      setTimeout(() => { delete addBtn.dataset['done']; }, 1500);
      document.dispatchEvent(new CustomEvent('od:open-bag'));
    });
    const order = document.getElementById('order') as HTMLAnchorElement;
    document.querySelectorAll<HTMLInputElement>('input[name=size]').forEach((r) =>
      r.addEventListener('change', () => {
        order.href = `https://wa.me/${order.dataset.phone}?text=${encodeURIComponent((order.dataset.base ?? '') + r.value)}`;
      }),
    );
  </script>
</Base>
