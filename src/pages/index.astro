---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import ProductCard from '../components/ProductCard.astro';
import Shoe from '../components/Shoe.astro';
import { BRAND, TAGLINE, catalog, categoryLabels } from '../data/site';

const featured = catalog[0]!;
const categories = [...new Set(catalog.map((p) => p.category))];
---

<Base title={`${BRAND} — Sneakers`} description={`${BRAND}: ${TAGLINE.toLowerCase()} Sneakers într-o estetică închisă, minimală. Comandă simplu pe WhatsApp.`}>
  <Intro slot="landing" />
  <section class="editorial" aria-label="Model recomandat">
    <a href={`/catalog/${featured.slug}/`} class="editorial-card">
      <Shoe hex={featured.hex} label={featured.name} />
      <div class="editorial-text">
        <p class="note">Model recomandat</p>
        <h2>{featured.name}</h2>
        <p class="bigprice">{featured.price} lei</p>
        <span class="btn solid">Vezi modelul</span>
      </div>
    </a>
  </section>
  {categories.map((c) => (
    <section class="rail" aria-label={categoryLabels[c] ?? c}>
      <h2>{categoryLabels[c] ?? c}</h2>
      <ul class="rail-list">
        {catalog.filter((p) => p.category === c).map((p) => <ProductCard product={p} />)}
      </ul>
    </section>
  ))}
  <section aria-labelledby="toate">
    <h2 id="toate">Toate modelele</h2>
    <ul class="grid">
      {catalog.map((p) => <ProductCard product={p} />)}
    </ul>
  </section>
</Base>
