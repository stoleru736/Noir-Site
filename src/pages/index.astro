---
import '../styles/global.css';
import { BRAND, TAGLINE } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
const description = `${BRAND}: ${TAGLINE.toLowerCase()} Sneakers într-o estetică închisă, minimală. Comandă simplu pe WhatsApp.`;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>{BRAND} — Sneakers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${BRAND} — Sneakers`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:url" content={canonical} />
    <link rel="prefetch" href="/magazin/" />
  </head>
  <body class="landing-page">
    <section class="landing" id="landing" aria-label="Introducere">
      <div class="landing-fallback" aria-hidden="true"></div>
      <canvas id="landing-canvas" aria-hidden="true"></canvas>
      <div class="landing-content">
        <h1 class="landing-logo">{BRAND}</h1>
        <p class="landing-sub">{TAGLINE}</p>
        <a href="/magazin/" id="enter" class="enter">ENTER THE EXPERIENCE</a>
      </div>
    </section>
    <script>
      import { initLanding } from '../scripts/landing';
      const landing = document.getElementById('landing');
      const canvas = document.getElementById('landing-canvas') as HTMLCanvasElement | null;
      const enter = document.getElementById('enter') as HTMLAnchorElement | null;
      if (landing && canvas && enter) initLanding(landing, canvas, enter);
    </script>
  </body>
</html>

<style is:global>
  html, body.landing-page { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .landing { position: fixed; inset: 0; background: #0b0b0b; --p: 0; }
  .landing-fallback { position: absolute; inset: 0; background:
    radial-gradient(120% 40% at 20% 78%, #2a2a2c 0%, transparent 60%),
    radial-gradient(110% 35% at 85% 92%, #333 0%, transparent 60%),
    radial-gradient(90% 30% at 60% 60%, #1b1b1d 0%, transparent 70%),
    linear-gradient(#0d0d0e, #161617 70%, #0b0b0b); }
  .landing.gl .landing-fallback { display: none; }
  #landing-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .6s; }
  #landing-canvas.on { opacity: 1; }
  .landing-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 1.25rem; text-shadow: 0 2px 24px #000; transition: opacity .5s, transform 1.1s ease-in; }
  .landing.leaving .landing-content { opacity: 0; transform: scale(1.15); pointer-events: none; }
  .landing-logo { margin: 0; font-weight: 200; letter-spacing: .45em; padding-left: .45em; font-size: clamp(2.6rem, 14vw, 6rem); line-height: 1.2; }
  .landing-sub { margin: 1rem 0 2.5rem; color: #cbbd9a; letter-spacing: .22em; font-size: clamp(.62rem, 2.6vw, .85rem); }
  .enter { display: inline-flex; align-items: center; min-height: 56px; padding: 0 2rem; font-size: .85rem; letter-spacing: .2em; color: #0b0b0b; text-decoration: none; text-shadow: none; touch-action: manipulation;
    background: linear-gradient(135deg, #f0deaa, #d4af37 55%, #b8902a); border-radius: 999px; box-shadow: 0 0 36px #d4af3744; }
  .enter:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .landing-content { transition: none; } }
</style>
